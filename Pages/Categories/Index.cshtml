@page "{id:int?}"
@model Mesaros_David_Lab2.Models.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Category) {
        <tr class="@(item.ID == Model.CategoryID ? "table-success" : "")">
            <td>
                <a asp-page="./Index" asp-route-id="@item.ID">@item.CategoryName</a>
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@if (Model.CategoryID.HasValue)
{
    <h2>Books in Selected Category</h2>
    @if (Model.Books.Count > 0)
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>@book.Title</td>
                        <td>@(book.Authors is null ? "Unknown author" : book.Authors.FullName)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>This category has no books yet.</p>
    }
}
